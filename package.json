{
  "name": "superjson-next",
  "version": "0.8.4",
  "description": "Automatically transform your Next.js Pages to use SuperJSON with SWC",
  "author": "https://github.com/serg-and",
  "homepage": "https://github.com/serg-and/superjson-next#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/serg-and/superjson-next.git"
  },
  "bugs": {
    "url": "https://github.com/serg-and/superjson-next/issues"
  },
  "license": "MIT",
  "keywords": [
    "swc-plugin"
  ],
  "type": "module",
  "main": "./dist/next_superjson.wasm",
  "exports": {
    ".": "./dist/next_superjson.wasm",
    "./tools": "./dist/tools.js",
    "./client": "./dist/client.js"
  },
  "preferUnplugged": true,
  "scripts": {
    "prepack": "tsc && cp target/wasm32-wasip1/release/next_superjson.wasm ./dist",
    "prepare": "husky install"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "next": "^16.1",
    "superjson": "^1 || ^2"
  },
  "dependencies": {
    "hoist-non-react-statics": "^3.3.2"
  },
  "devDependencies": {
    "next": "^16.1",
    "@types/hoist-non-react-statics": "^3.3.2",
    "@types/react": "18.3.1",
    "husky": "^8.0.2",
    "lint-staged": "^13.0.3",
    "prettier": "^2.7.1",
    "superjson": "^2",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "*.rs": [
      "rustfmt --"
    ],
    "*.{ts,json}": [
      "prettier --write"
    ]
  }
}